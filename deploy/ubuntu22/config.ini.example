# Run init_config.py to create a private configuration with a generated secret.
# Changes here do not change an already deployed configuration.
[api]
apiDebug=0
secret=GENERATE_WITH_INIT_CONFIG
snapRoot=/var/lib/zlm/www/snap
defaultSnap=/opt/zlm/www/logo.png
downloadRoot=/var/lib/zlm/www

[general]
mediaServerId=GENERATE_WITH_INIT_CONFIG
listen_ip=0.0.0.0
enableVhost=0
streamNoneReaderDelayMS=60000

[http]
port=8080
sslport=0
rootPath=/var/lib/zlm/www
dirMenu=0
allow_ip_range=::1,127.0.0.1,172.16.0.0-172.31.255.255,192.168.0.0-192.168.255.255,10.0.0.0-10.255.255.255

[rtmp]
port=1935
sslport=0

[rtsp]
port=8554
sslport=0

[protocol]
enable_mp4=0
enable_hls=0
enable_hls_fmp4=0
enable_rtmp=1
enable_rtsp=1
enable_ts=0
enable_fmp4=0
enable_audio=1
add_mute_audio=1
hls_demand=0
rtmp_demand=0
rtsp_demand=0
auto_close=0
modify_stamp=2
continue_push_ms=15000
mp4_max_second=3600
mp4_save_path=/var/lib/zlm/www
hls_save_path=/var/lib/zlm/www

[record_gap_fill]
enable=1
detect_ms=200
max_ms=15000
fps=25
bitrate=2000000

[hls]
segDur=2
segNum=0
segKeep=0
broadcastRecordTs=0

[hook]
enable=0

[cloud_upload]
enable=0
url=
method=PUT
timeout_sec=60
delete_after_upload=0
minio_enable=0
minio_endpoint=
minio_bucket=video
minio_access_key=
minio_secret_key=
minio_region=us-east-1
minio_object={app}/{stream}/{file_name}

[ffmpeg]
bin=/usr/bin/ffmpeg
log=/var/log/zlm/ffmpeg.log

[srt]
port=0

[rtp_proxy]
port=0

[shell]
port=0

[rtc]
port=0
tcpPort=0
